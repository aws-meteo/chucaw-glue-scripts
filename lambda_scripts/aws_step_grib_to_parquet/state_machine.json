{
    "Comment": "Orquestador Idempotente SbnAI Clima: Bronze to Platinum (Glue 5.0)",
    "StartAt": "FindPendingFiles",
    "States": {
        "FindPendingFiles": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "OutputPath": "$.Payload",
            "Parameters": {
                "FunctionName": "arn:aws:lambda:us-east-1:725644097028:function:chucaw-clima-diff-finder:$LATEST"
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 4,
                    "BackoffRate": 2
                }
            ],
            "Next": "CheckIfPending"
        },
        "CheckIfPending": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.count",
                    "NumericGreaterThan": 0,
                    "Next": "ProcessPendingFiles"
                }
            ],
            "Default": "NoFilesToProcess"
        },
        "NoFilesToProcess": {
            "Type": "Succeed",
            "Comment": "Ejecución idempotente: No hay archivos pendientes en Bronze."
        },
        "ProcessPendingFiles": {
            "Type": "Map",
            "ItemsPath": "$.pending_keys",
            "ItemProcessor": {
                "ProcessorConfig": {
                    "Mode": "INLINE"
                },
                "StartAt": "RunBronzeToPlatinumJob",
                "States": {
                    "RunBronzeToPlatinumJob": {
                        "Type": "Task",
                        "Resource": "arn:aws:states:::glue:startJobRun.sync",
                        "Parameters": {
                            "JobName": "bronze_to_platinum_as_parquet",
                            "Arguments": {
                                "--BRONZE_KEY.$": "$.bronze_key"
                            }
                        },
                        "Retry": [
                            {
                                "ErrorEquals": [
                                    "States.TaskFailed"
                                ],
                                "IntervalSeconds": 30,
                                "MaxAttempts": 3,
                                "BackoffRate": 2.0
                            }
                        ],
                        "End": true
                    }
                }
            },
            "MaxConcurrency": 5,
            "End": true
        }
    }
}